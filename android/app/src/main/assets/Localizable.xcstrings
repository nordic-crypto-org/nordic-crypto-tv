    "Free from Nordic Crypto, you pay a small Nexa network fee yourself.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis fra Nordic Crypto, du betaler selv et lite nettverksgebyr i Nexa."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis frå Nordic Crypto, du betaler sjølv eit lite nettverksgebyr i Nexa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis från Nordic Crypto, du betalar själv en liten nätverksavgift i Nexa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis fra Nordic Crypto, du betaler selv et lille netværksgebyr i Nexa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen Nordic Cryptolta, maksat itse pienen Nexa-verkkomaksun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ókeypis frá Nordic Crypto, þú greiðir sjálf(ur) lítið Nexa-netgjald."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Nordic Crypto 免费提供，你只需自付少量 Nexa 网络费用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordic Crypto की ओर से मुफ़्त, छोटा Nexa नेटवर्क शुल्क आप स्वयं चुकाते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis de Nordic Crypto; tú pagas una pequeña comisión de red de Nexa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offert par Nordic Crypto, vous payez vous-même de petits frais de réseau Nexa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاناً من Nordic Crypto، وتدفع بنفسك رسوم شبكة Nexa صغيرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordic Crypto থেকে বিনামূল্যে, ছোট একটি Nexa নেটওয়ার্ক ফি আপনি নিজে দেবেন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis da Nordic Crypto; você paga uma pequena taxa de rede Nexa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно от Nordic Crypto, небольшую комиссию сети Nexa вы платите сами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordic Crypto کی طرف سے مفت، Nexa نیٹ ورک کی معمولی فیس آپ خود ادا کرتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis dari Nordic Crypto, Anda membayar sendiri biaya jaringan Nexa yang kecil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos von Nordic Crypto, eine kleine Nexa-Netzwerkgebühr zahlst du selbst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordic Crypto から無料。少額の Nexa ネットワーク手数料はご自身でお支払いください。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bure kutoka Nordic Crypto, unalipa ada ndogo ya mtandao wa Nexa mwenyewe."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordic Crypto कडून मोफत, Nexa नेटवर्कचे छोटे शुल्क तुम्ही स्वतः भरता."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رایگان از طرف Nordic Crypto؛ کارمزد کوچک شبکهٔ Nexa را خودتان می‌پردازید."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовно від Nordic Crypto, невелику комісію мережі Nexa ви сплачуєте самі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordic Crypto'dan ücretsiz; küçük Nexa ağ ücretini siz ödersiniz."
          }
        }
      }
    },
