    "Edition of 1,000, while supply lasts.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplag på 1 000, så lenge lageret rekker."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplag på 1 000, så lenge lageret rekk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upplaga om 1 000, så långt lagret räcker."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplag på 1.000, så længe lager haves."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 000 kappaleen painos, niin kauan kuin riittää."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Upplag 1.000, meðan birgðir endast."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限量 1,000 枚，送完即止。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1,000 का संस्करण, स्टॉक रहने तक।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edición de 1.000, hasta agotar existencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Édition de 1 000, dans la limite des stocks disponibles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدار من 1000، حتى نفاد الكمية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "১,০০০টির সংস্করণ, সরবরাহ থাকা পর্যন্ত।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Edição de 1.000, enquanto durarem os estoques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тираж 1000, пока не закончатся."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "1,000 کا ایڈیشن، اسٹاک رہنے تک۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Edisi 1.000, selama persediaan masih ada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auflage von 1.000, solange der Vorrat reicht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "限定 1,000 個、なくなり次第終了。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Toleo la 1,000, hadi zitakapoisha."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "१,००० ची आवृत्ती, साठा असेपर्यंत."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخهٔ محدود ۱٬۰۰۰ عددی، تا پایان موجودی."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тираж 1000, поки є в наявності."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.000 adetlik seri, stoklar tükenene kadar."
          }
        }
      }
