# TestFlight lanes for Nordic Crypto: one multiplatform target, one bundle id
# (no.cryptonordic.tv), four Apple platforms.
#
#   bundle exec fastlane ios build_number                  # next build number, shared by all platforms
#   bundle exec fastlane ios beta platform:ios             # signed App Store build, upload to TestFlight
#   bundle exec fastlane ios distribute platform:ios       # wait for processing, What to Test, groups
#   bundle exec fastlane ios submit_review platform:tvos   # App Store review of an uploaded build (opt-in)
#
# platform: ios (iPhone and iPad), tvos (Apple TV), visionos (Apple Vision Pro)
# or macos (Mac). .github/workflows/testflight.yml runs them for every platform
# on every push to main. Credentials come from environment variables (GitHub
# Actions secrets and variables, set once by scripts/setup-signing-github.sh).
# Nothing secret is stored in the repository, and nothing here prints a secret.

# __dir__ is "." inside a Fastfile, so paths are built from the fastlane folder.
FASTLANE_DIR = File.expand_path(FastlaneCore::FastlaneFolder.path).freeze
ROOT_DIR = File.expand_path("..", FASTLANE_DIR).freeze

require "base64"
require "securerandom"
require "shellwords"
require "tmpdir"

default_platform(:ios)

def require_env(*names)
  missing = names.select { |name| ENV[name].to_s.strip.empty? }
  UI.user_error!("Missing environment variables: #{missing.join(', ')}") unless missing.empty?
end

def env_or(name, default)
  ENV[name].to_s.strip.empty? ? default : ENV[name].strip
end

# Writes a step output for the GitHub Actions workflow (no-op elsewhere).
def github_output(name, value)
  path = ENV["GITHUB_OUTPUT"].to_s
  File.open(path, "a") { |f| f.puts("#{name}=#{value}") } unless path.empty?
end

# A GitHub Actions annotation and step summary line, or a plain message locally.
def github_annotation(level, title, message)
  if ENV["GITHUB_ACTIONS"] == "true"
    puts "::#{level} title=#{title}::#{message.gsub(/\r?\n/, ' ')}"
    summary = ENV["GITHUB_STEP_SUMMARY"].to_s
    File.open(summary, "a") { |f| f.puts("**#{title}:** #{message}\n") } unless summary.empty?
  else
    UI.important("#{title}: #{message}")
  end
end

platform :ios do
  PROJECT_YML = File.join(ROOT_DIR, "project.yml").freeze
  XCODE_PROJECT = File.join(ROOT_DIR, "NordicCrypto.xcodeproj").freeze
  SCHEME = "NordicCrypto".freeze
  KEYCHAIN = "nordic-crypto-ci.keychain".freeze
  # The app's primary locale; TestFlight's "What to Test" is written there.
  WHAT_TO_TEST_LOCALE = "en-GB".freeze

  # Per platform: the SDK and destination to archive, fastlane's and
  # App Store Connect's name for it, the match profile (visionOS is signed with
  # the iOS App Store profile, which Apple issues for iOS and visionOS), the
  # match environment variable that names the profile, the package and the
  # altool upload type.
  TARGETS = {
    "ios" => {
      name: "iPhone and iPad", sdk: "iphoneos", destination: "generic/platform=iOS",
      fastlane: "ios", asc: "IOS", match: "ios", profile_env: "appstore", package: "ipa", altool: "ios"
    },
    "tvos" => {
      name: "Apple TV", sdk: "appletvos", destination: "generic/platform=tvOS",
      fastlane: "appletvos", asc: "TV_OS", match: "tvos", profile_env: "appstore_tvos", package: "ipa", altool: "appletvos"
    },
    "visionos" => {
      name: "Apple Vision Pro", sdk: "xros", destination: "generic/platform=visionOS",
      fastlane: "xros", asc: "VISION_OS", match: "ios", profile_env: "appstore", package: "ipa", altool: "visionos"
    },
    "macos" => {
      name: "Mac", sdk: "macosx", destination: "generic/platform=macOS",
      fastlane: "osx", asc: "MAC_OS", match: "macos", profile_env: "appstore_macos", package: "pkg", altool: "macos"
    }
  }.freeze

  def target_for(options)
    key = (options[:platform] || ENV["TESTFLIGHT_PLATFORM"]).to_s.strip.downcase
    TARGETS[key] or UI.user_error!("platform must be one of #{TARGETS.keys.join(', ')} (got '#{key}')")
    [key, TARGETS[key]]
  end

  # First value of `KEY: value` in project.yml (base settings come first).
  def project_setting(name)
    line = File.readlines(PROJECT_YML).find { |l| l =~ /^\s*#{Regexp.escape(name)}:\s*\S/ }
    UI.user_error!("#{name} not found in #{PROJECT_YML}") unless line
    line.split(":", 2).last.strip.delete('"')
  end

  def app_bundle_id
    env_or("APP_BUNDLE_ID", project_setting("PRODUCT_BUNDLE_IDENTIFIER"))
  end

  def marketing_version
    env_or("VERSION_NAME", project_setting("MARKETING_VERSION"))
  end

  def internal_group_name
    env_or("TESTFLIGHT_INTERNAL_GROUP", "internt")
  end

  def external_group_name
    env_or("TESTFLIGHT_EXTERNAL_GROUP", "Beta")
  end

  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true,
      duration: 1200
    )
  end

  def asc_app(api_key)
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    Spaceship::ConnectAPI::App.find(app_bundle_id) or UI.user_error!("No App Store Connect app for #{app_bundle_id}")
  end

  def asc_builds(app, platform: nil, version: nil, build_number: nil)
    Spaceship::ConnectAPI::Build.all(
      app_id: app.id, version: version, build_number: build_number,
      platform: platform, sort: "-uploadedDate", limit: 200
    )
  end

  def git(*args)
    out = IO.popen(["git", "-C", ROOT_DIR, *args], err: File::NULL, &:read)
    $?.success? ? out.strip : ""
  end

  # A commit message without trailers (Co-authored-by:, Signed-off-by:, ...).
  def commit_message(rev)
    git("log", "-1", "--format=%B", rev).lines.map(&:rstrip)
                                        .reject { |l| l =~ /\A[A-Za-z][A-Za-z-]*-[Bb]y:\s|\A[A-Z][A-Za-z]+-(Session|Id):\s/ }
                                        .join("\n").strip
  end

  # "What to Test": the message of the commit being built. For a GitHub merge
  # commit ("Merge pull request #N from ...") it is the PR title (the merge
  # commit's body), then the merged commit's message, or the subjects of the
  # merged commits when there are several. Needs the full history (checkout
  # with fetch-depth: 0).
  def what_to_test
    sha = git("rev-parse", env_or("GITHUB_SHA", "HEAD"))
    sha = env_or("GITHUB_SHA", "HEAD") if sha.empty?
    message = commit_message(sha)
    parents = git("rev-list", "--parents", "-n", "1", sha).split.drop(1)
    if parents.size == 2
      title = message.lines.drop(1).join.strip
      merged = git("log", "--reverse", "--format=%H", "#{parents[0]}..#{parents[1]}").split
      details = if merged.size == 1
                  commit_message(merged.first)
                else
                  merged.map { |c| "- #{git('log', '-1', '--format=%s', c)}" }.join("\n")
                end
      message = [title, details].reject(&:empty?).join("\n\n")
    end
    message = "Latest build from main." if message.empty?
    "#{message}\n\nCommit #{sha[0, 7]}"
  end

  # Uploads with Apple's altool and the API key (altool's platform names; the
  # key goes to a 0600 file in a private temp dir and is never printed).
  def altool_upload(path, altool_platform)
    Dir.mktmpdir("asc-key") do |dir|
      key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
      key_file = File.join(dir, "AuthKey_#{key_id}.p8")
      File.open(key_file, "w", 0o600) { |f| f.write(Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY"])) }
      UI.message("Uploading #{File.basename(path)} (#{altool_platform}) with altool")
      ok = system({ "API_PRIVATE_KEYS_DIR" => dir },
                  "xcrun", "altool", "--upload-app", "-f", path, "-t", altool_platform,
                  "--apiKey", key_id, "--apiIssuer", ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"])
      UI.user_error!("altool upload failed for #{File.basename(path)}") unless ok
    end
  end

  desc "Next build number for this run, shared by every platform: max(BUILD_NUMBER, latest build of any platform + 1)"
  lane :build_number do
    require_env("APP_STORE_CONNECT_API_KEY_ID", "APP_STORE_CONNECT_API_KEY_ISSUER_ID", "APP_STORE_CONNECT_API_KEY")
    app = asc_app(asc_api_key)
    latest = asc_builds(app).map { |b| b.version.to_i }.max || 0
    requested = ENV["BUILD_NUMBER"].to_i
    number = [requested, latest + 1].max
    UI.important("Build number #{requested} is taken (latest build is #{latest}); using #{number}") if number != requested
    UI.success("Build number #{number}")
    github_output("build_number", number)
    number
  end

  desc "Build one platform (platform:ios|tvos|visionos|macos) with App Store signing (match, readonly) and upload it to TestFlight"
  lane :beta do |options|
    key, target = target_for(options)
    require_env(
      "APPLE_TEAM_ID",
      "APP_STORE_CONNECT_API_KEY_ID",
      "APP_STORE_CONNECT_API_KEY_ISSUER_ID",
      "APP_STORE_CONNECT_API_KEY",
      "MATCH_GIT_URL",
      "MATCH_PASSWORD",
      "BUILD_NUMBER"
    )
    UI.user_error!("#{XCODE_PROJECT} is missing: run scripts/xcodegen.sh first") unless File.directory?(XCODE_PROJECT)
    app_id = app_bundle_id
    team_id = ENV["APPLE_TEAM_ID"]
    version = marketing_version
    build_number = ENV["BUILD_NUMBER"]
    api_key = asc_api_key
    app = asc_app(api_key)
    UI.message("Nordic Crypto for #{target[:name]} #{version} (#{build_number})")

    # A re-run after a successful upload: go straight to distribution.
    unless asc_builds(app, platform: target[:asc], version: version, build_number: build_number).empty?
      github_annotation("notice", "#{target[:name]}: already uploaded", "#{version} (#{build_number}) is in App Store Connect; not building it again.")
      next
    end

    build_dir = File.join(ROOT_DIR, "build", key)
    # A throwaway keychain holds the certificates for this job only.
    keychain_password = SecureRandom.hex(24)
    create_keychain(
      name: KEYCHAIN,
      password: keychain_password,
      default_keychain: false,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true
    )

    begin
      # readonly: CI only downloads certificates and profiles; it never creates
      # or revokes anything in the developer account. git_url comes from
      # MATCH_GIT_URL, read over SSH with the read-only deploy key that the
      # workflow sets up through GIT_SSH_COMMAND.
      # The Mac .pkg is signed with a Mac Installer Distribution certificate too.
      installer = key == "macos" ? { additional_cert_types: ["mac_installer_distribution"] } : {}
      match(
        type: "appstore",
        platform: target[:match],
        **installer,
        readonly: true,
        git_branch: env_or("MATCH_GIT_BRANCH", "main"),
        app_identifier: app_id,
        team_id: team_id,
        api_key: api_key,
        keychain_name: KEYCHAIN,
        keychain_password: keychain_password
      )
      profile_name = ENV["sigh_#{app_id}_#{target[:profile_env]}_profile-name"]
      UI.user_error!("match did not return a #{target[:match]} App Store profile for #{app_id}") if profile_name.to_s.empty?

      # Manual signing for this build only (command-line settings); project.yml
      # keeps automatic signing for local development.
      xcargs = {
        "CODE_SIGN_STYLE" => "Manual",
        "DEVELOPMENT_TEAM" => team_id,
        "CODE_SIGN_IDENTITY" => "Apple Distribution",
        "PROVISIONING_PROFILE_SPECIFIER" => profile_name,
        "PRODUCT_BUNDLE_IDENTIFIER" => app_id,
        "CURRENT_PROJECT_VERSION" => build_number,
        "MARKETING_VERSION" => version
      }.map { |k, v| "#{k}=#{v.shellescape}" }.join(" ")

      build_app(
        project: XCODE_PROJECT,
        scheme: SCHEME,
        configuration: "Release",
        sdk: target[:sdk],
        destination: target[:destination],
        export_method: "app-store",
        export_team_id: team_id,
        export_options: { provisioningProfiles: { app_id => profile_name } },
        xcargs: xcargs,
        output_directory: build_dir,
        derived_data_path: File.join(build_dir, "DerivedData"),
        output_name: "NordicCrypto-#{key}",
        clean: true
      )
      package = target[:package] == "pkg" ? lane_context[SharedValues::PKG_OUTPUT_PATH] : lane_context[SharedValues::IPA_OUTPUT_PATH]
      UI.user_error!("build_app produced no .#{target[:package]}") unless package && File.exist?(package)

      # Apple's processing takes a while; the distribute lane waits for it.
      altool_upload(package, target[:altool])
    ensure
      delete_keychain(name: KEYCHAIN)
    end

    UI.success("Uploaded #{target[:name]} #{version} (#{build_number})")
  end

  desc "Submit an uploaded build (platform:tvos, BUILD_NUMBER) for App Store review with manual release. Leaves metadata and screenshots untouched."
  lane :submit_review do |options|
    _key, target = target_for(options)
    require_env("APP_STORE_CONNECT_API_KEY_ID", "APP_STORE_CONNECT_API_KEY_ISSUER_ID", "APP_STORE_CONNECT_API_KEY", "BUILD_NUMBER")
    version = marketing_version
    build_number = ENV["BUILD_NUMBER"]
    api_key = asc_api_key
    app = asc_app(api_key)
    FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
      app_id: app.id,
      platform: target[:fastlane],
      app_version: version,
      build_version: build_number,
      poll_interval: 30,
      timeout_duration: 3600,
      return_spaceship_testflight_build: false
    )
    deliver(
      api_key: api_key,
      app_identifier: app_bundle_id,
      platform: target[:fastlane],
      app_version: version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true,
      submission_information: { add_id_info_uses_idfa: false }
    )
    UI.success("#{target[:name]} #{version} (#{build_number}) submitted for App Store review")
  end

  desc "Wait for processing, set What to Test, give one platform's build to the internal group and the external (public link) group"
  lane :distribute do |options|
    key, target = target_for(options)
    require_env(
      "APP_STORE_CONNECT_API_KEY_ID",
      "APP_STORE_CONNECT_API_KEY_ISSUER_ID",
      "APP_STORE_CONNECT_API_KEY",
      "BUILD_NUMBER"
    )
    build_number = ENV["BUILD_NUMBER"]
    version = marketing_version
    api_key = asc_api_key
    app = asc_app(api_key)

    FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
      app_id: app.id,
      platform: target[:fastlane],
      app_version: version,
      build_version: build_number,
      poll_interval: 30,
      timeout_duration: 3600,
      return_spaceship_testflight_build: false
    )
    build = asc_builds(app, platform: target[:asc], version: version, build_number: build_number).first or
      UI.user_error!("#{target[:name]} build #{version} (#{build_number}) not found")

    # Internal group: a group with access to all builds gets this one by itself.
    internal = app.get_beta_groups.find { |g| g.name == internal_group_name }
    if internal.nil?
      github_annotation("warning", "Internal group missing", "No TestFlight group named #{internal_group_name}.")
    elsif internal.has_access_to_all_builds
      UI.message("#{internal.name}: has access to all builds")
    else
      build.add_beta_groups(beta_groups: [internal])
      UI.message("#{internal.name}: build added")
    end

    next if ENV["TESTFLIGHT_INTERNAL_ONLY"] == "true"

    # External group with the public link: needs What to Test and (for a new
    # version) Beta App Review. While another build of this platform and
    # version is waiting for or in review, Apple refuses a second submission;
    # the build then stays with internal testers and the next push tries again.
    begin
      upload_to_testflight(
        api_key: api_key,
        distribute_only: true,
        app_identifier: app_bundle_id,
        app_platform: target[:fastlane],
        app_version: version,
        build_number: build_number,
        distribute_external: true,
        groups: [external_group_name],
        notify_external_testers: true,
        submit_beta_review: true,
        uses_non_exempt_encryption: false,
        # Off by default: with "true" a build still waiting for review is
        # withdrawn so this one can be submitted instead.
        reject_build_waiting_for_review: ENV["TESTFLIGHT_REJECT_BUILD_WAITING_FOR_REVIEW"] == "true",
        localized_build_info: { WHAT_TO_TEST_LOCALE => { whats_new: what_to_test } }
      )
      UI.success("#{target[:name]} #{version} (#{build_number}) sent to #{external_group_name}")
    rescue => e
      raise unless e.message =~ /another build|ANOTHER_BUILD|waiting for review/i
      github_annotation(
        "warning",
        "#{target[:name]}: external TestFlight waits",
        "#{version} (#{build_number}) is with internal testers. #{external_group_name} gets a later build: another #{target[:name]} build is still in Beta App Review (#{e.message})."
      )
    end
  end

  desc "Upload the Apple TV App Store metadata in fastlane/metadata (and fastlane/screenshots, if any). No binary, no review submission, no release."
  lane :metadata do
    require_env("APP_STORE_CONNECT_API_KEY_ID", "APP_STORE_CONNECT_API_KEY_ISSUER_ID", "APP_STORE_CONNECT_API_KEY")
    screenshots = File.join(FASTLANE_DIR, "screenshots")
    has_screenshots = !Dir.glob(File.join(screenshots, "*", "*.{png,jpg,jpeg}")).empty?
    options = {
      api_key: asc_api_key,
      app_identifier: app_bundle_id,
      platform: "appletvos",
      app_version: marketing_version,
      metadata_path: File.join(FASTLANE_DIR, "metadata"),
      screenshots_path: screenshots,
      skip_binary_upload: true,
      skip_screenshots: !has_screenshots,
      overwrite_screenshots: has_screenshots,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true
    }
    # Age rating is an owner declaration: uploaded only when asked for.
    options[:app_rating_config_path] = File.join(FASTLANE_DIR, "app_rating_config.json") if ENV["UPLOAD_AGE_RATING"] == "true"
    deliver(**options)
  end
end
